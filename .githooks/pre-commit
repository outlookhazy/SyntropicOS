#!/usr/bin/env bash
set -euo pipefail

# Pre-commit hook for SyntropicOS (Check-only; never auto-stages unstaged files)
echo "=== [Pre-Commit] Running Container Code Formatting Check (make container-format FIX=0) ==="

MAKE_BIN="make"
if command -v mingw32-make >/dev/null 2>&1 && ! command -v make >/dev/null 2>&1; then
    MAKE_BIN="mingw32-make"
fi

"${MAKE_BIN}" container-format FIX=0

echo "=== [Pre-Commit] Container Formatting Check PASS ==="
