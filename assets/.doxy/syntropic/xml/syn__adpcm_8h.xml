<codeline><highlight class="normal"><ref refid="syn__adpcm_8c_1abb7b433dacc551414912d3c429c0aba4" kindref="member">syn_adpcm_decode_block</ref>(&amp;state,<sp/>adpcm_data,<sp/>pcm_output,<sp/>sample_count);</highlight></codeline>
</programlisting> </para>
</simplesect>
</para>
