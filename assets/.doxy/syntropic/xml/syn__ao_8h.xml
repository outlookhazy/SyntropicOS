        <type>void</type>
        <definition>void syn_ao_init</definition>
        <argsstring>(SYN_ActiveObject *ao, SYN_Task *task, const char *name, SYN_Prio priority, const SYN_FSM_Transition *transitions, SYN_FSM_State initial_state, void *mailbox_buf, size_t mailbox_cap)</argsstring>
