        <definition>bool syn_ao_post</definition>
        <argsstring>(SYN_ActiveObject *ao, uint16_t sig, void *data)</argsstring>
        <name>syn_ao_post</name>
        <param>
          <type><ref refid="structSYN__ActiveObject" kindref="compound">SYN_ActiveObject</ref> *</type>
          <declname>ao</declname>
        </param>
        <param>
          <type>uint16_t</type>
          <declname>sig</declname>
        </param>
        <param>
          <type>void *</type>
          <declname>data</declname>
        </param>
        <briefdescription>
<para>Post an event to the Active Object&apos;s mailbox. </para>
        </briefdescription>
        <detaileddescription>
<para>Thread-safe and ISR-safe on the local core. Protects the mailbox write and blocked-task wakeup using critical sections (for cross-core messaging, use <computeroutput>syn_ipc</computeroutput>).</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>ao</parametername>
</parameternamelist>
<parameterdescription>
<para>Active Object instance. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>sig</parametername>
</parameternamelist>
<parameterdescription>
<para>Signal identifier. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>data</parametername>
</parameternamelist>
<parameterdescription>
<para>Optional payload. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>true if the event was successfully queued, false if queue is full. </para>
</simplesect>
</para>
        </detaileddescription>
