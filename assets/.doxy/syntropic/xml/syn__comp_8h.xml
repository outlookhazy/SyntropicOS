    <briefdescription>
<para>High-Speed Rail-to-Rail Analog Comparator Driver. </para>
    </briefdescription>
    <detaileddescription>
<para>Provides a vendor-agnostic, zero-allocation OS interface for internal analog comparators with configurable voltage reference thresholds (VREFINT 1.23V, DAC, or external).</para>
<para>Usage: <programlisting><codeline><highlight class="normal"><ref refid="structSYN__COMP" kindref="compound">SYN_COMP</ref><sp/>comp;</highlight></codeline>
<codeline><highlight class="normal"><ref refid="syn__comp_8c_1ac35ac24b5ae7973a1950091b36b2a993" kindref="member">syn_comp_init</ref>(&amp;comp,<sp/>0,<sp/><ref refid="syn__port__comp_8h_1a0676d91edce23317f2865c9bb2173a82a28c99d6c5c5dd21d84f0716bf4040ba1" kindref="member">SYN_COMP_INV_VREFINT</ref>);<sp/></highlight><highlight class="comment">//<sp/>COMP1<sp/>vs<sp/>1.23V<sp/>VREFINT</highlight><highlight class="normal"></highlight></codeline>
<codeline><highlight class="normal"><ref refid="syn__comp_8c_1aa2a6251f6d45ef3f70670d89181938f1" kindref="member">syn_comp_enable</ref>(&amp;comp,<sp/></highlight><highlight class="keyword">true</highlight><highlight class="normal">);</highlight></codeline>
<codeline><highlight class="normal"></highlight><highlight class="keywordtype">bool</highlight><highlight class="normal"><sp/>state<sp/>=<sp/><ref refid="syn__comp_8c_1aa60f5e4d7eab36889e1b7036d1bdaf6c" kindref="member">syn_comp_read</ref>(&amp;comp);<sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/><sp/></highlight><highlight class="comment">//<sp/>True<sp/>if<sp/>PA1<sp/>&gt;<sp/>1.23V</highlight></codeline>
