        <param><defname>ts</defname></param>
        <initializer>    do {                                                               \
        volatile uint32_t *syn_hp_lsb_p_ = <ref refid="syn__port__hpclock_8h_1a963768431af98199d8dc26e587d33722" kindref="member">syn_port_hpclock_lsb_ptr</ref>(); \
