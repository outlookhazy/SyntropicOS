        (ts).lsb = *syn_hp_lsb_p_;                                     \
        <ref refid="syn__compiler_8h_1a1afb4c3dfe60fc42928a5619e3100c23" kindref="member">SYN_COMPILER_BARRIER</ref>();                                        \
