<parameteritem>
<parameternamelist>
<parametername>task</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to owner task releasing the lock. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>SYN_OK on success, SYN_ERROR if not locked or wrong owner, or SYN_INVALID_PARAM. </para>
</simplesect>
</para>
        </detaileddescription>
