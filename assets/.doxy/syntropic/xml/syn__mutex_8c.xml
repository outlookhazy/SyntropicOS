        <param>
          <type><ref refid="structSYN__Task" kindref="compound">SYN_Task</ref> *</type>
          <declname>task</declname>
        </param>
        <briefdescription>
<para>Attempt to acquire the mutex without blocking. </para>
        </briefdescription>
        <detaileddescription>
<para>If the mutex is already locked by another task and <computeroutput>task</computeroutput> has higher priority (numerically lower value) than the owner, the owner&apos;s priority is automatically boosted.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>mutex</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to mutex structure. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>task</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to acquiring task (optional, NULL for standalone lock). </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>SYN_OK if acquired, SYN_BUSY if held by another task, or SYN_INVALID_PARAM. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
