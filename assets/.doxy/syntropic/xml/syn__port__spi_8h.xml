        <briefdescription>
<para>Initialize an SPI hardware instance. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>spi_id</parametername>
</parameternamelist>
<parameterdescription>
<para>Instance index (0 = SPI1, 1 = SPI2). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>baudrate_hz</parametername>
</parameternamelist>
<parameterdescription>
<para>Baudrate frequency in Hz (e.g. 1000000, 18000000). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>mode</parametername>
</parameternamelist>
<parameterdescription>
<para>SPI Mode: 0 (CPOL=0, CPHA=0), 1 (CPOL=0, CPHA=1), 2 (CPOL=1, CPHA=0), 3 (CPOL=1, CPHA=1). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>role</parametername>
</parameternamelist>
<parameterdescription>
<para>0 = Master, 1 = Slave. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>SYN_OK on success. </para>
</simplesect>
</para>
        </detaileddescription>
