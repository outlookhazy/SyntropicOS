    <sectiondef kind="typedef">
      <memberdef kind="typedef" id="syn__task_8h_1a302f26e07a61b95d91c626819c43c61d" prot="public" static="no">
        <type><ref refid="syn__pt_8h_1a837fcf03fa24b6b73d66bb133b95d79e" kindref="member">SYN_PT_Status</ref>(*</type>
        <definition>typedef SYN_PT_Status(* SYN_TaskFunc) (SYN_PT *pt, struct SYN_Task *task)</definition>
        <argsstring>)(SYN_PT *pt, struct SYN_Task *task)</argsstring>
        <name>SYN_TaskFunc</name>
        <briefdescription>
<para>Protothread task function. </para>
        </briefdescription>
        <detaileddescription>
<para>A task function receives its own protothread and task descriptor. It must follow the PT_BEGIN / PT_END pattern.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>pt</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the task&apos;s protothread (same as &amp;task-&gt;pt). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>task</parametername>
</parameternamelist>
<parameterdescription>
<para>Pointer to the task descriptor (for user_data, delay, etc.). </para>
</parameterdescription>
</parameteritem>
</parameterlist>
