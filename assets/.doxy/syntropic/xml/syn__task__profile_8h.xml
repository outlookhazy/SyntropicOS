        <type>uint32_t</type>
        <definition>uint32_t syn_task_profile_task_budget_us</definition>
        <argsstring>(const SYN_TaskProfileManager *mgr, const SYN_Sched *sched, size_t task_idx, uint8_t *out_peer_prio)</argsstring>
        <name>syn_task_profile_task_budget_us</name>
        <param>
          <type>const <ref refid="structSYN__TaskProfileManager" kindref="compound">SYN_TaskProfileManager</ref> *</type>
          <declname>mgr</declname>
        </param>
        <param>
          <type>const <ref refid="structSYN__Sched" kindref="compound">SYN_Sched</ref> *</type>
          <declname>sched</declname>
        </param>
        <param>
          <type>size_t</type>
