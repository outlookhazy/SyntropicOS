      <memberdef kind="define" id="syn__udp_8h_1a863113d250e55e0e8c8b151a32724a38" prot="public" static="no">
        <name>PT_UDP_BLOCK_READ</name>
        <param><defname>pt</defname></param>
        <param><defname>task</defname></param>
        <param><defname>sock</defname></param>
        <param><defname>buf</defname></param>
        <param><defname>max_len</defname></param>
        <param><defname>bytes_read</defname></param>
        <param><defname>src_ip</defname></param>
        <param><defname>src_port</defname></param>
        <initializer>    do {                                                                              \
        (sock)-&gt;blocked_task = (task);                                                \
        <ref refid="syn__pt_8h_1ad044a817ad60164750e4486f5b91cf27" kindref="member">PT_BLOCK_CONDITION</ref>(pt, task, (sock)-&gt;rx_len &gt; 0 || !(sock)-&gt;is_bound);        \
        if ((sock)-&gt;rx_len &gt; 0) {                                                     \
            size_t _n = ((sock)-&gt;rx_len &lt; (max_len)) ? (sock)-&gt;rx_len : (max_len);    \
            memcpy((buf), (sock)-&gt;rx_buf, _n);                                        \
            memmove((sock)-&gt;rx_buf, (sock)-&gt;rx_buf + _n, (sock)-&gt;rx_len - _n);        \
            (sock)-&gt;rx_len -= _n;                                                     \
            *(bytes_read) = _n;                                                       \
            if (src_ip)                                                               \
                *(src_ip) = (sock)-&gt;remote_ip;                                        \
            if (src_port)                                                             \
                *(src_port) = (sock)-&gt;remote_port;                                    \
        } else {                                                                      \
            *(bytes_read) = 0;                                                        \
        }                                                                             \
    } while (0)</initializer>
        <briefdescription>
<para>Protothread helper macro to block task until UDP packet arrives. </para>
        </briefdescription>
        <detaileddescription>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
