        <definition>bool syn_uds_dtc_from_str</definition>
        <argsstring>(const char *str, uint32_t *dtc_out)</argsstring>
        <name>syn_uds_dtc_from_str</name>
        <param>
          <type>const char *</type>
          <declname>str</declname>
        </param>
        <param>
          <type>uint32_t *</type>
          <declname>dtc_out</declname>
        </param>
        <briefdescription>
<para>Parse a 5, 6, or 7-character SAE J2012 DTC string into a 24-bit UDS integer. </para>
        </briefdescription>
        <detaileddescription>
<para>Accepts strings like:<itemizedlist>
<listitem><para>&quot;P0105&quot; or &quot;P010500&quot; -&gt; 0x010500</para>
</listitem><listitem><para>&quot;B111717&quot; -&gt; 0x911717</para>
</listitem><listitem><para>&quot;U013100&quot; -&gt; 0xC13100</para>
</listitem><listitem><para>&quot;C101000&quot; -&gt; 0x501000</para>
</listitem></itemizedlist>
</para>
<para>Case-insensitive for prefix (p/c/b/u or P/C/B/U) and hex digits.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>str</parametername>
</parameternamelist>
<parameterdescription>
<para>Null-terminated SAE J2012 DTC string. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>dtc_out</parametername>
</parameternamelist>
<parameterdescription>
<para>[out] Destination for parsed 24-bit DTC value. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>true if successfully parsed, false on invalid format. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
