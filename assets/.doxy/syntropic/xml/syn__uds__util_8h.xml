        <type><ref refid="syn__defs_8h_1af6a258d8f3ee5206d682d799316314b1" kindref="member">bool</ref></type>
        <definition>bool syn_uds_dtc_to_str</definition>
        <argsstring>(uint32_t dtc, char *out_buf, size_t buf_size)</argsstring>
        <name>syn_uds_dtc_to_str</name>
        <param>
          <type>uint32_t</type>
          <declname>dtc</declname>
        </param>
        <param>
          <type>char *</type>
          <declname>out_buf</declname>
        </param>
        <param>
          <type>size_t</type>
          <declname>buf_size</declname>
        </param>
        <briefdescription>
<para>Format a 24-bit UDS integer into a standard SAE J2012 DTC display string. </para>
        </briefdescription>
        <detaileddescription>
<para>Formats values like:<itemizedlist>
<listitem><para>0x010500 -&gt; &quot;P010500&quot;</para>
</listitem><listitem><para>0x911717 -&gt; &quot;B111717&quot;</para>
</listitem><listitem><para>0xC13100 -&gt; &quot;U013100&quot;</para>
</listitem></itemizedlist>
</para>
<para>Buffer must have a capacity of at least 8 bytes (7 chars + null terminator).</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>dtc</parametername>
</parameternamelist>
<parameterdescription>
<para>24-bit UDS DTC integer value. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>out_buf</parametername>
</parameternamelist>
<parameterdescription>
<para>Destination string buffer. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>buf_size</parametername>
</parameternamelist>
<parameterdescription>
<para>Capacity of output buffer (minimum 8 bytes). </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>true if formatted successfully, false if buffer too small or NULL. </para>
</simplesect>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
