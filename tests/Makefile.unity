# Unity framework
UNITY_SRCS := tests/unit/unity/unity.c

# Mock port layer
MOCK_SRCS := tests/unit/mocks/mock_port.c

# Build output directory
BUILD_DIR := build/tests

# All per-module test files
TEST_SRCS := $(wildcard tests/unit/test_*.c)

ALL_SRCS := $(MOCK_SRCS) $(SYN_SRCS) $(UNITY_SRCS) $(TEST_SRCS)
OBJS     := $(patsubst %.c,$(BUILD_DIR)/%.o,$(ALL_SRCS))

-include $(OBJS:.o=.d)

.PHONY: all test test-cov clean

all: test

WASM_CC     := clang
WASM_CFLAGS := --target=wasm32-unknown-unknown -O2 -nostdlib \
               -mbulk-memory -msign-ext -mmultivalue -mnontrapping-fptoint \
               -Wl,--no-entry -Wl,--export-all -Wl,--allow-undefined -Wl,-z,stack-size=1024
WASM_SRCS   := $(wildcard tests/wasm/*.c)
WASM_HDRS   := $(patsubst tests/wasm/%.c,$(BUILD_DIR)/wasm/%.wasm.h,$(WASM_SRCS))

$(BUILD_DIR)/wasm/%.wasm: tests/wasm/%.c
	@mkdir -p $(BUILD_DIR)/wasm
	$(WASM_CC) $(WASM_CFLAGS) $< -o $@

$(BUILD_DIR)/wasm/%.wasm.h: $(BUILD_DIR)/wasm/%.wasm
	(cd $(BUILD_DIR)/wasm && xxd -i $(notdir $<)) > $@

wasm-fixtures: $(WASM_HDRS)

$(OBJS): | wasm-fixtures

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(BUILD_DIR)/test_unity: $(OBJS)
	$(CC) $(CFLAGS) $(OBJS) -o $@ -lm -lpthread $(LDFLAGS)

.PHONY: test-cov FORCE

test-cov: CFLAGS += --coverage
test-cov: LDFLAGS += --coverage
test-cov: FORCE
	rm -rf $(BUILD_DIR)
	$(MAKE) -f tests/Makefile.unity $(BUILD_DIR)/test_unity CFLAGS="$(CFLAGS) --coverage" LDFLAGS="$(LDFLAGS) --coverage"
	{ ./$(BUILD_DIR)/test_unity 2>&1; echo $$? > $(BUILD_DIR)/test_unity.rc; } | tee $(BUILD_DIR)/test_out.txt; EXIT_CODE=$$(cat $(BUILD_DIR)/test_unity.rc); rm -f $(BUILD_DIR)/test_unity.rc; grep -E "FAIL|Expected|Was" $(BUILD_DIR)/test_out.txt || true; exit $$EXIT_CODE

test_unity: $(BUILD_DIR)/test_unity

test: $(BUILD_DIR)/test_unity
	./$(BUILD_DIR)/test_unity

ARM_CC      := arm-none-eabi-gcc
ARM_CFLAGS  := -MMD -MP -mcpu=cortex-m4 -mthumb -mabi=aapcs -mfloat-abi=soft -mno-unaligned-access -std=c99 -pedantic -Wall -Wextra \
               -O2 -fno-exceptions -fno-unwind-tables -fno-asynchronous-unwind-tables \
               -ffunction-sections -fdata-sections -I. -Isrc -Itests/unit -Itests/unit/mocks -I$(BUILD_DIR) \
               -DSYN_LOG_COLOR=0 -DSYN_CLI_HISTORY_DEPTH=4 -DSYN_LOG_USE_PRINTF=1 -DSYN_USE_COREDUMP=1 -DSYN_COREDUMP_FLASH_ADDR=0 -DSYN_USE_TICKLESS=1 \
               -DSYN_USE_DMA=1 -DSYN_USE_I2C_ASYNC=1 -DSYN_USE_SPI_ASYNC=1 -DSYN_FW_USE_HMAC=1 -DSYN_FW_USE_ED25519=1 -DSYN_FW_USE_AES_GCM=1 -DSYN_USE_PORT_AES=1 -DSYN_USE_MULTICORE=1 \
               -DUNITY_OUTPUT_CHAR=semihosting_putc -DUNITY_FLUSH=qemu_flush_dummy -DUNITY_EXCLUDE_FLOAT_PRINT -DUNITY_INCLUDE_DOUBLE -DUNITY_SUPPORT_64 -DSYN_USE_METRICS=1 -DSYN_USE_ROUTER=1 -DSYN_USE_LIN=1 -DSYN_USE_LINTP=1 -DSYN_USE_GBT27930=1 -DSYN_USE_CANNM=1 -DSYN_USE_IR=1 \
               -DSYN_USE_SMBUS=1 -DSYN_USE_PMBUS=1 -DSYN_USE_MBUS=1 -DSYN_USE_DLT645=1 -DSYN_USE_AT_PARSER=1 \
               -DSYN_USE_BACNET=1 -DSYN_USE_DEVICENET=1 -DSYN_USE_YMODEM=1 \
               -DSYN_USE_AUDIO=1 -DSYN_USE_ADPCM=1 -DSYN_USE_SBC=1 -DSYN_USE_BLE=1 -DSYN_USE_OTA=1 -DSYN_USE_LWM2M_TASK=1 \
               -DSYN_USE_CAN_FD=1 -DSYN_USE_RTC=1 \
               -Wno-unused-parameter -Wno-unused-variable -Wno-unused-but-set-variable -Wno-format -Wno-stringop-truncation -Wno-type-limits

ARM_OBJS    := $(patsubst %.c,$(BUILD_DIR)/arm/%.o,$(ALL_SRCS))

-include $(ARM_OBJS:.o=.d)

$(BUILD_DIR)/arm/%.o: %.c tests/Makefile.unity | wasm-fixtures
	@mkdir -p $(dir $@)
	$(ARM_CC) $(ARM_CFLAGS) -c $< -o $@

$(BUILD_DIR)/test_cortexm4.elf: tests/emulation/startup_cortexm4.c $(ARM_OBJS) tests/emulation/qemu_arm.ld tests/Makefile.unity
	$(ARM_CC) $(ARM_CFLAGS) -T tests/emulation/qemu_arm.ld tests/emulation/startup_cortexm4.c $(ARM_OBJS) -Wl,--gc-sections -Wl,--start-group -lc -lm -lrdimon -Wl,--end-group -o $@

.PHONY: qemu-build

qemu-build: wasm-fixtures $(BUILD_DIR)/test_cortexm4.elf




clean:
	rm -f test_unity test_unity_cov coverage.info coverage_src.info
	rm -rf coverage_html $(BUILD_DIR)
	find . \( -name "*.gcda" -o -name "*.gcno" -o -name "*.su" \) -delete
