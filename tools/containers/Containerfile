# SyntropicOS Lightweight Test & Tooling Container
FROM debian:trixie-slim

# Install compilation tools, sanitizers, cross-compilers, QEMU ARM, libFuzzer, static analysis, coverage & Doxygen tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    clang \
    clang-tools \
    clang-format \
    clang-tidy \
    lld-19 \
    xxd \
    libclang-rt-dev \
    make \
    cmake \
    git \
    libasan8 \
    libtsan2 \
    libubsan1 \
    gcc-arm-none-eabi \
    libnewlib-arm-none-eabi \
    qemu-system-arm \
    lcov \
    libjson-xs-perl \
    gcovr \
    cppcheck \
    valgrind \
    doxygen \
    graphviz \
    python3 \
    python3-pip \
    python3-venv \
    ca-certificates \
    openssl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["make", "-C", "tools/containers", "help"]
